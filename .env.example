# Copy to .env and adjust. Never commit real secrets.
# Generate a secret with:  python -c "import secrets;print(secrets.token_urlsafe(48))"

# PostgreSQL (one schema per component: core, c1, c2, c3, c4; see infra/postgres/README.md)
POSTGRES_USER=diacare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=diacare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://diacare:change-me@localhost:5432/diacare

# Service URLs used by the API gateway (port 8000)
C1_URL=http://localhost:8001
C2_URL=http://localhost:8002
C3_URL=http://localhost:8003
C4_URL=http://localhost:8004

# Trust between the gateway and the services (ADR 0005). The SAME value in every service.
INTERNAL_TOKEN=change-me-to-a-long-random-string

# Gateway login (ADR 0005)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
GATEWAY_DATABASE_URL=postgresql+psycopg://diacare:change-me@localhost:5432/diacare
# No self sign-up before ethical clearance. Create demo accounts with:
#   uv run python -m diacare_gateway.cli create-user --email you@example.test --demo
REGISTRATION_ENABLED=false
AUTH_REQUIRED=true
# Only while the app has no login screen: AUTH_REQUIRED=false plus a fixed demo patient.
# Never use this with real patients.
# DEMO_PATIENT_ID=00000000-0000-4000-8000-000000000001
# Services asked to delete a patient's data (comma separated). Add c2,c3,c4 when they store data.
DELETE_FANOUT_SERVICES=c1
# Browser origins allowed to call the gateway (comma separated). Empty for the mobile app.
# Only for local browser checks of the Flutter web build, e.g.:
#   flutter run -d web-server --web-port 5600   ->   CORS_ORIGINS=http://localhost:5600
CORS_ORIGINS=

# C1: trained model and real nutrition table (optional; see scripts/start_c1.ps1)
RECOGNIZER=mock
# MODEL_PATH=
# MODEL_DEVICE=cpu
# NUTRITION_TABLE_PATH=data/c1/c1_foods_combined.csv

# MLflow experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000

LOG_LEVEL=INFO
