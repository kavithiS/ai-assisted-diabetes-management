# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (one schema per component: c1, c2, c3, c4)
POSTGRES_USER=diacare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=diacare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://diacare:change-me@localhost:5432/diacare

# Service URLs used by the API gateway (port 8000)
C1_URL=http://localhost:8001
C2_URL=http://localhost:8002
C3_URL=http://localhost:8003
C4_URL=http://localhost:8004

# MLflow experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000

LOG_LEVEL=INFO
